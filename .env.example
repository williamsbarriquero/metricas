# Copie para .env (esta pasta, de onde o programa é iniciado).
# Gere o token em https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://rpetech.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=

# Opcionais. 8090 deixa o app só em HTML (go run . a partir de golang/, porta 8080) livre.
ADDR=127.0.0.1:8090
# DB_PATH=data/metricas.db
# JIRA_CONCORRENCIA=12

# Slide (OAuth, cliente tipo Desktop). Redirect: http://127.0.0.1:8090/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
